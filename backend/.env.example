PORT=4000
NODE_ENV=development
# CORS: ใส่ origin ของเว็บทดสอบ (Expo web ปกติ http://localhost:8081)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# 2 ฐานข้อมูล
DB_USERS_NAME=kitgle_users
DB_DEVICES_NAME=kitgle_devices
