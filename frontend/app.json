{
  "expo": {
    "name": "KIT - GLE",
    "slug": "kit-gle",
    "version": "0.1.0",
    "scheme": "kitgle",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/auth-hero.jpg",
    "backgroundColor": "#222222",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kitgle.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "KIT - GLE ใช้ Bluetooth เพื่อเชื่อมต่อกับนาฬิกาของคุณ",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kitgle.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#4CD04F"
      },
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "KIT - GLE ใช้ Bluetooth เพื่อเชื่อมต่อกับนาฬิกาของคุณ"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "KIT - GLE ขอเข้าถึงรูปภาพเพื่อใช้เป็นรูปยาใน MediRemind"
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e0c1a2b4-9f36-43c0-9d86-181bc55b67fd"
      }
    },
    "owner": "armmers"
  }
}
