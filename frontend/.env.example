# คัดลอกเป็น .env แล้วแก้ค่า (EXPO_PUBLIC_* จะถูกฝังในแอป ห้ามใส่ความลับ)
# มือถือจริง: ใช้ IP เครื่องคอมในวง Wi-Fi เดียวกัน เช่น http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# true = ใช้นาฬิกาจำลอง (ไม่ต้องมี BLE จริง) / false = ใช้ BLE จริง (ต้อง dev build)
EXPO_PUBLIC_USE_MOCK_BLE=true
